PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/momaa-ai
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Set AI_PROVIDER=groq to use Groq's OpenAI-compatible Responses API.
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=replace-with-your-gemini-api-key-when-using-gemini
GEMINI_MODEL=gemini-2.0-flash
# Meta App Dashboard > WhatsApp > Configuration: choose this verification string yourself.
WHATSAPP_VERIFY_TOKEN=replace-with-your-webhook-verification-token
# Meta Business Settings > System Users: token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=replace-with-your-meta-system-user-access-token
# Meta App Dashboard > WhatsApp > API Setup: the sending/test phone number ID.
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-meta-phone-number-id
# Meta Business Settings > Accounts > WhatsApp Accounts: your WhatsApp Business Account ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-your-meta-business-account-id
# Cloudinary Dashboard > API Keys: needed only for incoming WhatsApp image/audio uploads.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
